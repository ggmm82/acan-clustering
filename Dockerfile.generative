# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    ACAN_LM_DATA=/data HF_HOME=/data/hub OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 HF_HUB_DISABLE_XET=1
WORKDIR /app
COPY requirements/llm.lock /app/requirements/llm.lock
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export PIP_CERT=/run/secrets/proxy_ca; fi; \
    python -m pip install --no-cache-dir 'torch==2.15.0' --index-url "$TORCH_INDEX_URL" \
    && python -m pip install --no-cache-dir --require-hashes --no-deps -r requirements/llm.lock
COPY pyproject.toml README.md LICENSE ./
COPY acan ./acan
RUN python -m pip install --no-cache-dir --no-deps --no-build-isolation . \
    && rm -rf /app/acan /app/build /app/*.egg-info \
    && useradd --uid 10001 --create-home acan \
    && mkdir /data && chown 10001:10001 /data
USER 10001
ARG ACAN_BUILD_REVISION=development
ENV ACAN_BUILD_REVISION=$ACAN_BUILD_REVISION
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz',timeout=3)"
CMD ["python", "-m", "acan.lm.service"]
